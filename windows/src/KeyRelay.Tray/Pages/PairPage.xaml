<Page
    x:Class="KeyRelay.Tray.Pages.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyRelay.Tray">
    <Page.Resources>
        <!-- Runs only while a code is open on screen: stops on success, expiry, hide/minimize and when the page unloads. -->
        <Storyboard x:Name="SweepStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SweepTransform" Storyboard.TargetProperty="Y" From="-94" To="236" Duration="0:0:2.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="QrCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="QrScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="QrScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <StackPanel>
            <TextBlock x:Uid="PairTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Lead" Style="{StaticResource LeadStyle}" />
            <Grid x:Name="PairGrid" ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid x:Name="QrArea" VerticalAlignment="Top" Padding="14">
                    <!-- Static glow behind the code, in the brand's aurora colours. -->
                    <Rectangle RadiusX="20" RadiusY="20" Opacity="0.55" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#CC3B6CFF" Offset="0.45" />
                                <GradientStop Color="#557A5CFF" Offset="0.8" />
                                <GradientStop Color="#0022D3EE" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid x:Name="QrCard" Width="236" Height="236" CornerRadius="14" Background="White" Padding="14" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="QrScale" />
                        </Grid.RenderTransform>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,236,236" />
                        </Grid.Clip>
                        <Image x:Name="QrImage" Stretch="Uniform" />
                        <Rectangle x:Name="SweepBand" Height="94" VerticalAlignment="Top" Margin="-14,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#004C7DFF" Offset="0" />
                                    <GradientStop Color="#664C7DFF" Offset="0.5" />
                                    <GradientStop Color="#004C7DFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="SweepTransform" Y="-94" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- One scan pass when the tablet has read the code. -->
                        <Rectangle x:Name="Beam" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Top" Margin="-6,-11,-6,0" Fill="{StaticResource BrandAccentBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="ExpiredFrame" Margin="-14" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource ErrorBrush}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="10">
                    <StackPanel x:Name="Side" Spacing="10">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphShield}" /></Border>
                                    <TextBlock x:Name="IdentityLabel" x:Uid="PairIdentityLabel" Style="{StaticResource CardKeyStyle}" />
                                    <local:InfoTip TextKey="InfoIdentity" />
                                </StackPanel>
                                <!-- PC identity code as a badge of cells; screen readers get the whole code. -->
                                <StackPanel x:Name="IdentityCells" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" AutomationProperties.LabeledBy="{x:Bind IdentityLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ProgressRing x:Name="Countdown" Width="64" Height="64" IsIndeterminate="False" Maximum="300" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Remaining" FontFamily="{StaticResource NumberFont}" FontSize="26" FontWeight="ExtraBold" CharacterSpacing="-40" />
                                    <TextBlock x:Name="ExpiredText" x:Uid="PairExpiredShort" Style="{StaticResource CardKeyStyle}" Visibility="Collapsed" />
                                </StackPanel>
                                <local:InfoTip TextKey="InfoCountdown" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphGlobe}" /></Border>
                                    <TextBlock x:Uid="PairAddressesLabel" Style="{StaticResource CardKeyStyle}" />
                                    <local:InfoTip TextKey="InfoAddresses" />
                                </StackPanel>
                                <TextBlock x:Name="Addresses" FontFamily="{StaticResource NumberFont}" FontSize="13.5" Margin="0,8,0,0" LineHeight="23" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="PairNewCode" Style="{StaticResource AccentButtonStyle}" Click="OnNewCode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="NewCodeIcon" Glyph="{StaticResource GlyphRefresh}" FontSize="14" RenderTransformOrigin="0.5,0.5" />
                                <TextBlock x:Uid="PairNewCodeText" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="PairClose" AutomationProperties.AutomationId="PairClose" Click="OnClose" />
                    </StackPanel>
                    <InfoBar x:Name="Result" IsClosable="False" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <!-- Scene layer: code caps, wires and the device card are drawn here, then removed. -->
        <Canvas x:Name="Fx" IsHitTestVisible="False" />
    </Grid>
</Page>

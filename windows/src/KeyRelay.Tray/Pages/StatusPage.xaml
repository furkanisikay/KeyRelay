<Page
    x:Class="KeyRelay.Tray.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyRelay.Tray">
    <Page.Resources>
        <Style x:Key="ArcIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource Glass2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body">
            <TextBlock x:Uid="StatusTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Lead" Style="{StaticResource LeadStyle}" />
            <!-- First run only: part of the page, gone for good once "Anladım" is pressed (tray.json IntroSeen). -->
            <Border x:Name="IntroCard" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource KeyTileStyle}" VerticalAlignment="Top"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="&#xE946;" /></Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="IntroTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="IntroBody" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                    <Button x:Uid="IntroClose" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="IntroClose" Click="OnIntroClose" />
                </Grid>
            </Border>
            <!-- Hero: colour, badge shape and the light line all follow the state. -->
            <Border x:Name="Hero" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Rectangle x:Name="Glow" RadiusX="8" RadiusY="8" IsHitTestVisible="False" />
                    <StackPanel Margin="20,16,20,14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Grid x:Name="Badge" Width="50" Height="50" AutomationProperties.AccessibilityView="Raw">
                                <Path x:Name="BadgeShape" />
                                <Viewbox x:Name="BadgeGlyph" Width="23" Height="23">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="ArrowGlyph" Data="M5,12 H18 M13,6 L19,12 L13,18" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Path x:Name="DotsGlyph" Data="M6,12 H6.01 M12,12 H12.01 M18,12 H18.01" Stroke="White" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path x:Name="BangGlyph" Data="M12,6 V13 M12,17.5 V18" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="StateLabel" FontSize="12" FontWeight="ExtraBold" CharacterSpacing="180" VerticalAlignment="Center" />
                                    <local:InfoTip TextKey="InfoState" />
                                </StackPanel>
                                <TextBlock x:Name="Headline" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="Bold" CharacterSpacing="-35" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="Sub" Margin="0,6,0,0" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                        <!-- Tablet to PC light line; coordinates follow the mockup's 760 x 170 drawing. -->
                        <Viewbox Margin="-6,4,-6,2" MaxHeight="170" AutomationProperties.AccessibilityView="Raw">
                            <Canvas Width="760" Height="170">
                                <Canvas x:Name="Line">
                                    <Path x:Name="HaloA" Data="M122,108 C175,38.7 277.5,4.05 380,4.05" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path x:Name="HaloB" Data="M380,4.05 C482.5,4.05 585,38.7 638,108" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path x:Name="CoreA" Data="M122,108 C175,38.7 277.5,4.05 380,4.05" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path x:Name="CoreB" Data="M380,4.05 C482.5,4.05 585,38.7 638,108" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                                <Grid x:Name="ErrorMark" Canvas.Left="367" Canvas.Top="-9" Width="26" Height="26">
                                    <Ellipse Fill="{StaticResource ErrorBrush}" />
                                    <Path Data="M8,8 L18,18 M18,8 L8,18" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <Grid x:Name="WaitMark" Canvas.Left="367" Canvas.Top="-9" Width="26" Height="26">
                                    <Ellipse Fill="{StaticResource WaitingBrush}" />
                                    <Path Data="M8.5,13 H8.51 M13,13 H13.01 M17.5,13 H17.51" Stroke="#2B1E00" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <Grid Canvas.Left="42" Canvas.Top="76" Width="72" Height="72">
                                    <Border CornerRadius="24" Background="{ThemeResource NodeBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1.5" />
                                    <Viewbox Width="34" Height="34">
                                        <Path Style="{StaticResource ArcIconStyle}" Data="M6.5,2 H17.5 A2.5,2.5 0 0 1 20,4.5 V19.5 A2.5,2.5 0 0 1 17.5,22 H6.5 A2.5,2.5 0 0 1 4,19.5 V4.5 A2.5,2.5 0 0 1 6.5,2 Z M11,18 H13" />
                                    </Viewbox>
                                </Grid>
                                <Grid x:Name="PcNode" Canvas.Left="646" Canvas.Top="76" Width="72" Height="72">
                                    <Border CornerRadius="24" Background="{ThemeResource NodeBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1.5" />
                                    <Viewbox Width="34" Height="34">
                                        <Path Style="{StaticResource ArcIconStyle}" Data="M5,4 H19 A2,2 0 0 1 21,6 V14 A2,2 0 0 1 19,16 H5 A2,2 0 0 1 3,14 V6 A2,2 0 0 1 5,4 Z M8,20 H16 M12,16 V20" />
                                    </Viewbox>
                                </Grid>
                                <Ellipse x:Name="BurstRing" Canvas.Left="666" Canvas.Top="96" Width="32" Height="32" StrokeThickness="3" Opacity="0" />
                                <!-- Keycap that flies along the line when keys arrive; hidden at rest. -->
                                <Grid x:Name="KeyCap" Canvas.Left="102" Canvas.Top="94" Width="40" Height="29" Opacity="0">
                                    <Border Margin="0,4,0,0" CornerRadius="8" Background="#9FB4FF" />
                                    <Border Height="25" VerticalAlignment="Top" CornerRadius="8" Background="#F2F6FF">
                                        <TextBlock x:Name="KeyCapText" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="ExtraBold" Foreground="#1E3A8F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="DeviceDot" Width="9" Height="9" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DeviceValue" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="LinkDot" Width="9" Height="9" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LinkValue" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphGauge}" /></Border>
                            <TextBlock x:Uid="StatusLatencyLabel" Style="{StaticResource CardKeyStyle}" />
                            <local:InfoTip TextKey="InfoLatency" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0">
                            <Run x:Name="P50Value" FontFamily="{StaticResource NumberFont}" FontSize="36" FontWeight="ExtraBold" CharacterSpacing="-50" />
                            <Run x:Name="P99Value" FontSize="14" Foreground="{ThemeResource MutedBrush}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="StatusGraphLabel" Style="{StaticResource CardKeyStyle}" />
                            <local:InfoTip TextKey="InfoGraph" />
                        </StackPanel>
                        <!-- Slowest key of each of the last 60 seconds; redrawn only when new data arrives. -->
                        <Viewbox Stretch="Fill" Height="80" Margin="0,8,0,0" AutomationProperties.AccessibilityView="Raw">
                            <Canvas Width="360" Height="80">
                                <Path x:Name="WaveArea" Opacity="0.45">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9922D3EE" Offset="0" />
                                            <GradientStop Color="#0022D3EE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path x:Name="WaveLine" Stroke="#22D3EE" StrokeThickness="2.4" StrokeLineJoin="Round" />
                                <Line x:Name="P50Line" X2="360" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1" StrokeDashArray="3,4" Opacity="0.7" />
                                <Line x:Name="P99Line" X2="360" Stroke="{ThemeResource MutedBrush}" StrokeThickness="1" StrokeDashArray="3,4" Opacity="0.7" />
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphKeyboard}" /></Border>
                            <TextBlock x:Uid="StatusTodayLabel" Style="{StaticResource CardKeyStyle}" />
                            <local:InfoTip TextKey="InfoKeysToday" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0">
                            <Run x:Name="KeysValue" FontFamily="{StaticResource NumberFont}" FontSize="36" FontWeight="ExtraBold" CharacterSpacing="-50" />
                            <Run x:Uid="StatusKeysUnit" FontSize="14" Foreground="{ThemeResource MutedBrush}" />
                        </TextBlock>
                        <!-- Last keys: key names only when the user turns them on (eye); otherwise "+N" from the counter. -->
                        <Grid Margin="0,10,0,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock x:Uid="StatusRecentLabel" Style="{StaticResource RowTextStyle}" />
                                <local:InfoTip TextKey="InfoRecentKeys" />
                            </StackPanel>
                            <StackPanel x:Name="Strip" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                            <Button x:Name="EyeButton" AutomationProperties.AutomationId="StatusShowKeys" Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="OnToggleKeys">
                                <FontIcon x:Name="EyeIcon" FontSize="14" Foreground="{ThemeResource MutedBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphUser}" /></Border>
                            <TextBlock x:Uid="StatusSessionLabel" Style="{StaticResource CardKeyStyle}" />
                            <local:InfoTip TextKey="InfoSession" />
                        </StackPanel>
                        <TextBlock x:Name="SessionValue" Style="{StaticResource CardValueStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Ellipse x:Name="DesktopDot" Width="9" Height="9" />
                            <TextBlock x:Name="DesktopValue" Style="{StaticResource RowTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource KeyTileStyle}"><FontIcon Style="{StaticResource KeyGlyphStyle}" Glyph="{StaticResource GlyphGlobe}" /></Border>
                            <TextBlock x:Uid="StatusAddressLabel" Style="{StaticResource CardKeyStyle}" />
                            <local:InfoTip TextKey="InfoAddress" />
                        </StackPanel>
                        <TextBlock x:Name="AddressValue" Style="{StaticResource CardValueStyle}" FontFamily="{StaticResource NumberFont}" FontSize="14" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="AddressMore" Style="{StaticResource RowTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

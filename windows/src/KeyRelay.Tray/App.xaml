<Application
    x:Class="KeyRelay.Tray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Mockup palette: dark is the brand, light uses the mockup's light counterparts. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Navy tint over Mica, so the brand survives any wallpaper. -->
                    <RadialGradientBrush x:Key="WindowTintBrush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="1.3">
                        <GradientStop Color="#E61A2647" Offset="0" />
                        <GradientStop Color="#EB101728" Offset="0.55" />
                        <GradientStop Color="#F20D1220" Offset="1" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="ContentAreaBrush" Color="#4D0B111C" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#9E1E2536" />
                    <SolidColorBrush x:Key="Glass2Brush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="LineBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NodeBrush" Color="#111A29" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9AA8C0" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#5E6C8C" />
                    <SolidColorBrush x:Key="AccentLightBrush" Color="#89A8FF" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#4D0B111C" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <RadialGradientBrush x:Key="WindowTintBrush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="1.3">
                        <GradientStop Color="#D9DCE6FF" Offset="0" />
                        <GradientStop Color="#E6EEF1F7" Offset="0.55" />
                        <GradientStop Color="#F2E9EEF8" Offset="1" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="ContentAreaBrush" Color="#4DF7F9FD" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#A8FFFFFF" />
                    <SolidColorBrush x:Key="Glass2Brush" Color="#0D0B111C" />
                    <SolidColorBrush x:Key="LineBrush" Color="#1A0B111C" />
                    <SolidColorBrush x:Key="NodeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#4D5A73" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#8A97B0" />
                    <SolidColorBrush x:Key="AccentLightBrush" Color="#2A4FC9" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#4DF7F9FD" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#1A0B111C" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="WindowTintBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ContentAreaBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="SurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="Glass2Brush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="LineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="NodeBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="MutedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="FaintBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                    <StaticResource x:Key="AccentLightBrush" ResourceKey="SystemColorHotlightColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Brand accent #4C7DFF replaces the system accent: one colour language on Android and Windows. -->
            <Color x:Key="SystemAccentColor">#4C7DFF</Color>
            <Color x:Key="SystemAccentColorLight1">#6A93FF</Color>
            <Color x:Key="SystemAccentColorLight2">#89A8FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B3C6FF</Color>
            <Color x:Key="SystemAccentColorDark1">#3A66E0</Color>
            <Color x:Key="SystemAccentColorDark2">#2A4FC9</Color>
            <Color x:Key="SystemAccentColorDark3">#1E3A8F</Color>
            <SolidColorBrush x:Key="ReadyBrush" Color="#2FD49C" />
            <SolidColorBrush x:Key="WaitingBrush" Color="#F2B544" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#4C7DFF" />
            <SolidColorBrush x:Key="KeyTileBrush" Color="#294C7DFF" />
            <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Manrope.ttf#Manrope</FontFamily>
            <FontFamily x:Key="NumberFont">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>
            <!-- Fluent icon glyphs used next to card titles. -->
            <x:String x:Key="GlyphGauge">&#xEC4A;</x:String>
            <x:String x:Key="GlyphKeyboard">&#xE765;</x:String>
            <x:String x:Key="GlyphUser">&#xE77B;</x:String>
            <x:String x:Key="GlyphGlobe">&#xE774;</x:String>
            <x:String x:Key="GlyphShield">&#xEA18;</x:String>
            <x:String x:Key="GlyphFingerprint">&#xE928;</x:String>
            <x:String x:Key="GlyphPort">&#xE839;</x:String>
            <x:String x:Key="GlyphRefresh">&#xE72C;</x:String>
            <x:String x:Key="GlyphTablet">&#xE70A;</x:String>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,16" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="-35" />
                <Setter Property="Margin" Value="0,8,0,6" />
            </Style>
            <Style x:Key="LeadStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="CardKeyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BigNumberStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <Setter Property="CharacterSpacing" Value="-50" />
            </Style>
            <Style x:Key="KeyTileStyle" TargetType="Border">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource KeyTileBrush}" />
            </Style>
            <Style x:Key="KeyGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource BrandAccentBrush}" />
            </Style>
            <!-- Isometric keycap mark, drawn instead of the PNG so it stays sharp and background-free. -->
            <DataTemplate x:Key="LogoTemplate">
                <Viewbox>
                    <Canvas Width="64" Height="64">
                        <Path Data="M8,26 L32,38 L32,50 L8,38 Z" Fill="#9FB4FF" />
                        <Path Data="M56,26 L32,38 L32,50 L56,38 Z" Fill="#6F8BEA" />
                        <Canvas>
                            <Canvas.RenderTransform>
                                <MatrixTransform Matrix="1,0.5,-1,0.5,32,14" />
                            </Canvas.RenderTransform>
                            <Rectangle Width="24" Height="24" RadiusX="5" RadiusY="5" Fill="#F2F6FF" />
                            <Path Data="M6,12 H17 M13,8 L17,12 L13,16" Stroke="#1E3A8F" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

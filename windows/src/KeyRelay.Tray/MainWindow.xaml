<Window
    x:Class="KeyRelay.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeyRelay">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="{ThemeResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0">
            <TextBlock x:Uid="AppTitle" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource MutedBrush}" />
        </Grid>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="236"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,4,0,8">
                    <ContentControl Width="24" Height="24" ContentTemplate="{StaticResource LogoTemplate}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Uid="AppTitle" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="16" FontWeight="ExtraBold" CharacterSpacing="-30" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavStatus" AutomationProperties.AutomationId="NavStatus" Tag="status">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DevicesItem" x:Uid="NavDevices" AutomationProperties.AutomationId="NavDevices" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPair" AutomationProperties.AutomationId="NavPair" Tag="pair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED14;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavNetwork" AutomationProperties.AutomationId="NavNetwork" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLogs" AutomationProperties.AutomationId="NavLogs" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="30,16,30,24" FontFamily="{StaticResource BodyFont}" />
        </NavigationView>    </Grid>
</Window>
